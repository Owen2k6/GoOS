window FormDemo {
    title = "Registration Form"
    width = 400
    height = 350
    background = #E8E8E8
    
    label TitleLabel {
        x = 20
        y = 20
        text = "User Registration Form"
        textColour = #004080
    }
    
    label NameLabel {
        x = 20
        y = 60
        text = "Full Name:"
        textColour = black
    }
    
    input NameInput {
        x = 120
        y = 55
        width = 260
        height = 25
        placeholder = "Enter your full name"
    }
    
    label EmailLabel {
        x = 20
        y = 95
        text = "Email:"
        textColour = black
    }
    
    input EmailInput {
        x = 120
        y = 90
        width = 260
        height = 25
        placeholder = "Enter your email address"
    }
    
    label AgeLabel {
        x = 20
        y = 130
        text = "Age:"
        textColour = black
    }
    
    input AgeInput {
        x = 120
        y = 125
        width = 60
        height = 25
        placeholder = "Age"
    }
    
    label GenderLabel {
        x = 20
        y = 165
        text = "Gender:"
        textColour = black
    }
    
    radio MaleRadio {
        x = 120
        y = 165
        text = "Male"
        group = "gender"
        checked = false
    }
    
    radio FemaleRadio {
        x = 200
        y = 165
        text = "Female"
        group = "gender"
        checked = false
    }
    
    radio OtherRadio {
        x = 280
        y = 165
        text = "Other"
        group = "gender"
        checked = false
    }
    
    label InterestsLabel {
        x = 20
        y = 200
        text = "Interests:"
        textColour = black
    }
    
    checkbox TechCheckbox {
        x = 120
        y = 200
        text = "Technology"
        checked = false
    }
    
    checkbox MusicCheckbox {
        x = 120
        y = 225
        text = "Music"
        checked = false
    }
    
    checkbox SportsCheckbox {
        x = 220
        y = 200
        text = "Sports"
        checked = false
    }
    
    checkbox ArtCheckbox {
        x = 220
        y = 225
        text = "Art"
        checked = false
    }
    
    checkbox AcceptTerms {
        x = 20
        y = 260
        text = "I accept the terms and conditions"
        checked = false
    }
    
    button SubmitButton {
        x = 200
        y = 300
        width = 100
        height = 30
        text = "Submit"
        onClick {
            message "Form submitted!\nThank you for registering.";
        }
    }
    
    button CancelButton {
        x = 310
        y = 300
        width = 70
        height = 30
        text = "Cancel"
        onClick {
            close;
        }
    }
}