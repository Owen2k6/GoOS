window CalculatorDemo {
    title = "Giff Calculator"
    width = 240
    height = 300
    background = #E0E0E0
    
    label ResultDisplay {
        x = 20
        y = 20
        width = 200
        height = 30
        text = "0"
        textColour = black
    }
    
    // First row
    button Btn7 {
        x = 20
        y = 60
        width = 45
        height = 40
        text = "7"
        onClick {
            message "7 pressed";
        }
    }
    
    button Btn8 {
        x = 75
        y = 60
        width = 45
        height = 40
        text = "8"
        onClick {
            message "8 pressed";
        }
    }
    
    button Btn9 {
        x = 130
        y = 60
        width = 45
        height = 40
        text = "9"
        onClick {
            message "9 pressed";
        }
    }
    
    button BtnDivide {
        x = 185
        y = 60
        width = 45
        height = 40
        text = "÷"
        onClick {
            message "Divide pressed";
        }
    }
    
    // Second row
    button Btn4 {
        x = 20
        y = 110
        width = 45
        height = 40
        text = "4"
        onClick {
            message "4 pressed";
        }
    }
    
    button Btn5 {
        x = 75
        y = 110
        width = 45
        height = 40
        text = "5"
        onClick {
            message "5 pressed";
        }
    }
    
    button Btn6 {
        x = 130
        y = 110
        width = 45
        height = 40
        text = "6"
        onClick {
            message "6 pressed";
        }
    }
    
    button BtnMultiply {
        x = 185
        y = 110
        width = 45
        height = 40
        text = "×"
        onClick {
            message "Multiply pressed";
        }
    }
    
    // Third row
    button Btn1 {
        x = 20
        y = 160
        width = 45
        height = 40
        text = "1"
        onClick {
            message "1 pressed";
        }
    }
    
    button Btn2 {
        x = 75
        y = 160
        width = 45
        height = 40
        text = "2"
        onClick {
            message "2 pressed";
        }
    }
    
    button Btn3 {
        x = 130
        y = 160
        width = 45
        height = 40
        text = "3"
        onClick {
            message "3 pressed";
        }
    }
    
    button BtnSubtract {
        x = 185
        y = 160
        width = 45
        height = 40
        text = "-"
        onClick {
            message "Subtract pressed";
        }
    }
    
    // Fourth row
    button Btn0 {
        x = 20
        y = 210
        width = 45
        height = 40
        text = "0"
        onClick {
            message "0 pressed";
        }
    }
    
    button BtnClear {
        x = 75
        y = 210
        width = 45
        height = 40
        text = "C"
        onClick {
            message "Clear pressed";
        }
    }
    
    button BtnEquals {
        x = 130
        y = 210
        width = 45
        height = 40
        text = "="
        onClick {
            message "Equals pressed";
        }
    }
    
    button BtnAdd {
        x = 185
        y = 210
        width = 45
        height = 40
        text = "+"
        onClick {
            message "Add pressed";
        }
    }
    
    button BtnBack {
        x = 20
        y = 260
        width = 80
        height = 30
        text = "Back"
        onClick {
            close;
        }
    }
}
