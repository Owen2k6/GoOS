window DemoMenu {
    title = "Giff Demo System"
    width = 400
    height = 330
    x = 100
    y = 50
    background = #E8E8E8
    
    label TitleLabel {
        x = 20
        y = 20
        text = "Giff Demo System v0.27"
        textColour = #004080
    }
    
    label SubtitleLabel {
        x = 20
        y = 40
        text = "A demonstration of Giff features for GoOS"
        textColour = #606060
    }
    
    panel DemoPanel {
        x = 20
        y = 70
        width = 360
        height = 200
        background = #F8F8F8
        
        button CalculatorDemo {
            x = 20
            y = 20
            width = 150
            height = 30
            text = "Calculator Demo"
            onClick {
                message "Opening Calculator Demo...";
            }
        }
        
        button FileOperationsDemo {
            x = 190
            y = 20
            width = 150
            height = 30
            text = "File Operations"
            onClick {
                message "Opening File Operations Demo...";
            }
        }
        
        button ControlsDemo {
            x = 20
            y = 60
            width = 150
            height = 30
            text = "UI Controls"
            onClick {
                message "Opening UI Controls Demo...";
            }
        }
        
        button FormDemo {
            x = 190
            y = 60
            width = 150
            height = 30
            text = "Form Demo"
            onClick {
                message "Opening Form Demo...";
            }
        }
        
        button GameDemo {
            x = 20
            y = 100
            width = 150
            height = 30
            text = "Simple Game"
            onClick {
                message "Opening Game Demo...";
            }
        }
        
        button ColourDemo {
            x = 190
            y = 100
            width = 150
            height = 30
            text = "Colour Showcase"
            onClick {
                message "Opening Colour Showcase...";
            }
        }
        
        listbox FeaturesList {
            x = 20
            y = 140
            width = 320
            height = 50
            item "• Labels, buttons, inputs, checkboxes, radio buttons"
            item "• Panels for grouping elements"
            item "• ListBoxes for displaying lists"
            item "• File operations and event handling"
            onSelect {
                message "Giff features include UI elements and file operations";
            }
        }
    }
    
    label FooterLabel {
        x = 20
        y = 280
        text = "Created with Giff for GoOS - British UI Technology"
        textColour = #606060
    }
    
    button CloseButton {
        x = 300
        y = 280
        width = 80
        height = 30
        text = "Close"
        onClick {
            close;
        }
    }
    
    onLoad {
        message "Welcome to the Giff Demo System!\nExplore the demos to see what Giff can do.";
    }
}