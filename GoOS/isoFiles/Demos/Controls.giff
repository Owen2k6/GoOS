window ControlsDemo {
    title = "UI Controls Demo"
    width = 450
    height = 400
    background = #E8E8E8
    
    label TitleLabel {
        x = 20
        y = 20
        text = "UI Controls Showcase"
        textColour = #004080
    }
    
    panel InputPanel {
        x = 20
        y = 50
        width = 410
        height = 100
        background = #F0F0F0
        
        label InputLabel {
            x = 10
            y = 10
            text = "Text Inputs"
            textColour = #004080
        }
        
        input StandardInput {
            x = 10
            y = 35
            width = 180
            height = 25
            placeholder = "Standard input"
        }
        
        input PasswordInput {
            x = 210
            y = 35
            width = 180
            height = 25
            placeholder = "Password field"
        }
        
        label InputExplainLabel {
            x = 10
            y = 70
            text = "Inputs can be used for text entry and forms"
            textColour = #606060
        }
    }
    
    panel SelectionPanel {
        x = 20
        y = 160
        width = 410
        height = 130
        background = #F0F0F0
        
        label SelectionLabel {
            x = 10
            y = 10
            text = "Selection Controls"
            textColour = #004080
        }
        
        checkbox Checkbox1 {
            x = 10
            y = 35
            text = "Enable feature A"
            checked = true
        }
        
        checkbox Checkbox2 {
            x = 10
            y = 60
            text = "Enable feature B"
            checked = false
        }
        
        radio RadioOption1 {
            x = 210
            y = 35
            text = "Option 1"
            group = "options"
            checked = true
        }
        
        radio RadioOption2 {
            x = 210
            y = 60
            text = "Option 2"
            group = "options"
            checked = false
        }
        
        radio RadioOption3 {
            x = 210
            y = 85
            text = "Option 3"
            group = "options"
            checked = false
        }
    }
    
    panel ListPanel {
        x = 20
        y = 300
        width = 200
        height = 90
        background = #F0F0F0
        
        label ListLabel {
            x = 10
            y = 10
            text = "ListBox Control"
            textColour = #004080
        }
        
        listbox DemoList {
            x = 10
            y = 35
            width = 180
            height = 45
            item "Item 1"
            item "Item 2"
            item "Item 3"
            onSelect {
                message "Item selected!";
            }
        }
    }
    
    image LogoImage {
        x = 230
        y = 300
        width = 64
        height = 64
        src = "logo.png"
    }
    
    label ImageLabel {
        x = 300
        y = 320
        text = "Image Control"
        textColour = #004080
    }
    
    button BackButton {
        x = 350
        y = 15
        width = 80
        height = 30
        text = "Back"
        onClick {
            close;
        }
    }
}
