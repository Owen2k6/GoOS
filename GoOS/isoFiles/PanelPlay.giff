window PanelPlay {
  title = "Panel layout"; x = 300; y = 40; width = 420; height = 260; background = #E8ECEF;

  panel {
    x = 16; y = 20; width = 280; height = 140; background = #D8D8D8;

    label  { text = "Inside (10,10)"; x = 10; y = 10; textColour = black; }
    input  { x = 10; y = 30; width = 180; height = 20; placeholder = "Panel input"; }
    button { text = "Panel Button"; x = 10; y = 60; width = 120; height = 24;
      onClick { message "Panel button clicked"; }
    }
    checkbox { x = 160; y = 60; width = 120; height = 20; text = "Tick me"; checked = false; }
    radio    { x = 160; y = 84; width = 120; height = 20; text = "Choice A"; group = "grp1"; checked = true; }
    radio    { x = 160; y = 106; width = 120; height = 20; text = "Choice B"; group = "grp1"; checked = false; }
  }

  button { text = "Close"; x = 320; y = 220; width = 80; height = 24; onClick { close; } }
}